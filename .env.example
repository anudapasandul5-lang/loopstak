# Public site origin (canonical URLs). Required for production builds.
NEXT_PUBLIC_SITE_URL=

# WhatsApp number in international format, digits only (e.g. 94771234567)
NEXT_PUBLIC_WHATSAPP=

# Booking page for the free Idea call (https only, e.g. a Cal.com link). Without it, the button opens WhatsApp or the form.
NEXT_PUBLIC_CAL_URL=

# Inquiry form delivery via Resend (https://resend.com)
RESEND_API_KEY=
LEAD_NOTIFY_TO=
LEAD_FROM=
