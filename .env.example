# Copy to .env.local for local work. In production, set these in Vercel. Never commit real values.

# Public site origin (canonical URLs). Required for production builds, e.g. https://loopstak.com
NEXT_PUBLIC_SITE_URL=

# Resend API key. Sends the instant reply to the client and the email copy to you.
RESEND_API_KEY=
# The "from" address on emails, e.g. Loopstak <hello@yourdomain.com>. The domain must be verified in Resend.
LEAD_FROM=
# Your own email. Every enquiry is copied here, plus the private summary.
LEAD_NOTIFY_TO=
# Token of your Telegram bot (from BotFather).
TELEGRAM_BOT_TOKEN=
# Your Telegram chat id, so the bot knows where to message you.
TELEGRAM_CHAT_ID=
# Anthropic API key. Writes the private summary and next step, only for you.
ANTHROPIC_API_KEY=
# Optional. Which Claude model writes the summary. Defaults to claude-haiku-4-5.
ANTHROPIC_MODEL=
# Email address of the Google service account that is allowed to edit your Sheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The service account private key. Paste it as one line with \n where the line breaks were.
GOOGLE_PRIVATE_KEY=
# The long id in your Google Sheet link, between /d/ and /edit.
GOOGLE_SHEET_ID=
# Your Cal.com booking link, shown in the client reply and on the site.
NEXT_PUBLIC_CAL_LINK=
# Your WhatsApp number in international format, digits only (e.g. 94771234567). Used for the site button and the client reply.
NEXT_PUBLIC_WHATSAPP=
# PostHog project key (starts with phc_). Leave empty to turn analytics and the consent banner off. Set at build time.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional PostHog API host. Leave empty for the EU default, https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=
