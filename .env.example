# Public site origin (canonical URLs). Required for production builds.
NEXT_PUBLIC_SITE_URL=

# WhatsApp number in international format, digits only (e.g. 94771234567)
NEXT_PUBLIC_WHATSAPP=

# Inquiry form delivery via Resend (https://resend.com)
RESEND_API_KEY=
LEAD_NOTIFY_TO=
LEAD_FROM=

# Cal.com booking link for the free Idea call (falls back to the on-page form)
NEXT_PUBLIC_CAL_LINK=
